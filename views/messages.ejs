<%- include('partials/header', { title: 'Сообщения — The Attic' }) %>

<div class="messages-page">
    <div class="messages-page-heading">
        <div>
            <h1 class="page-title">Личные сообщения</h1>
            <p class="page-subtitle">Ваши личные беседы на чердаке.</p>
        </div>
        <span class="messages-heading-badge">✉ Переписка</span>
    </div>

    <div class="messages-layout">
        <aside class="dialogs-sidebar">
            <div class="dialogs-header">
                <span>Диалоги</span>
                <span class="dialogs-count">3 собеседника</span>
            </div>
            
            <a href="/messages?user=Lydia" class="dialog-item <%= activeUser === 'Lydia' ? 'active' : '' %>">
                <div class="dialog-avatar">L</div>
                <div class="dialog-info">
                    <div class="dialog-name-row">
                        <span>Lydia</span>
                        <span style="font-size: 0.72rem; color: #a3917f;">09:42</span>
                    </div>
                    <div class="dialog-last-msg">Спасибо за отзыв к утреннему кофе!</div>
                </div>
            </a>

            <a href="/messages?user=Arthur" class="dialog-item <%= activeUser === 'Arthur' ? 'active' : '' %>">
                <div class="dialog-avatar" style="background: #2a1f2b; border-color: #8c71a3;">A</div>
                <div class="dialog-info">
                    <div class="dialog-name-row">
                        <span>Arthur</span>
                        <span style="font-size: 0.72rem; color: #a3917f;">Вчера</span>
                    </div>
                    <div class="dialog-last-msg">Где ты нашла такую шкатулку?</div>
                </div>
            </a>

            <a href="/messages?user=Polina" class="dialog-item <%= activeUser === 'Polina' ? 'active' : '' %>">
                <div class="dialog-avatar" style="background: #4a1017; border-color: #c89f6d;">P</div>
                <div class="dialog-info">
                    <div class="dialog-name-row">
                        <span>Polina</span>
                        <span style="font-size: 0.72rem; color: #a3917f;">14:02</span>
                    </div>
                    <div class="dialog-last-msg">Стрелка компаса до сих пор указывает на север...</div>
                </div>
            </a>
        </aside>

        <section class="chat-window">
            <div class="chat-header">
                <div class="dialog-avatar chat-header-avatar">
                    <%= activeUser[0] %>
                </div>
                <div class="chat-contact-info">
                    <strong style="color: #f7eee4;"><%= activeUser %></strong>
                    <div class="chat-contact-status"><span></span> Собеседник</div>
                </div>
            </div>

            <div class="chat-history">
                <% if (messages.length) { %>
                    <% messages.forEach(message => { %>
                        <div class="message-bubble <%= message.fromUser === user.name ? 'message-out' : 'message-in' %>">
                            <%= message.messageText %>
                            <span class="message-time"><%= new Date(message.createdAt).toLocaleString('ru-RU', { dateStyle: 'short', timeStyle: 'short' }) %></span>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="chat-empty-state">
                        <span class="chat-empty-icon">✉</span>
                        <strong>Начните беседу</strong>
                        <span>Напишите <%= activeUser %> первое сообщение.</span>
                    </div>
                <% } %>
            </div>

            <form action="/messages/send" method="POST" class="chat-input-area">
                <input type="hidden" name="toUser" value="<%= activeUser %>">
                <input type="text" name="messageText" class="form-control" placeholder="Напишите сообщение..."
                       minlength="1" maxlength="1000" pattern=".*\S.*" title="Сообщение не может состоять только из пробелов" required>
                <button type="submit" class="btn-primary chat-send-button">
                    Отправить <span aria-hidden="true">➤</span>
                </button>
            </form>
        </section>
    </div>
</div>

<%- include('partials/footer') %>